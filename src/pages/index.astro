---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CtaBand from '../components/CtaBand.astro';
import CheckIcon from '../components/CheckIcon.astro';
import { site } from '../data/site';

const featuredServices = [
  {
    title: 'Plumbing Repairs',
    href: '/plumbing-repairs',
    image: '/images/gallery/under-sink-valve-repair.jpg',
    text: 'Leaks, clogs, running toilets, bad valves and more, fixed promptly by licensed plumbers.',
  },
  {
    title: 'Water & Sewer Line Replacement',
    href: '/sewer-water-line-replacements',
    image: '/images/gallery/excavator-pipe-removal.jpg',
    text: 'Failing water and sewer lines dug out and replaced, including old cast iron, with our own crews and equipment.',
  },
  {
    title: 'New Construction Plumbing',
    href: '/new-construction-plumbing',
    image: '/images/gallery/gallery-18.jpg',
    text: 'Complete site work and plumbing systems for residential and commercial construction projects.',
  },
];

const plumbingList = [
  'Plumbing repairs for sinks, faucets, drains, showers, bathtubs, toilets and more',
  'Hot water heaters (sales, installation, service, repair, and replacement)',
  'Pipe replacement',
  'Leak detection',
  'Video inspection',
  'Sprinkler systems',
];

const specialtyList = [
  'Water and sewer line replacement',
  'Pipe locating for buried water and sewer lines',
  'New construction plumbing, residential and commercial',
  'Concrete removal',
];

const highlights = [
  {
    title: 'Quality Plumber',
    text: 'We take pride in leaving each customer satisfied. Whether we are installing new fixtures for your sink or servicing your hot water heater, we treat each plumbing repair with care.',
    // Wrench
    iconPath:
      'M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z',
  },
  {
    title: 'Free Estimates',
    text: 'Tell us what is going on and we will give you a straight answer and a free estimate before any work starts, anywhere in Asheville, Hendersonville, NC, and the surrounding areas.',
    // Clipboard with check
    iconPath:
      'M19 3h-4.18C14.4 1.84 13.3 1 12 1s-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm-2 14l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z',
  },
  {
    title: 'Lower Your Utility Bill',
    text: "Don't throw money away using old equipment with low efficiency. Allow our plumbers to service your hot water heater and save money on your utility bills every month!",
    // Bolt
    iconPath:
      'M11 21h-1l1-7H7.5c-.58 0-.57-.32-.38-.66.19-.34.05-.08.07-.12C8.48 10.94 10.42 7.54 13 3h1l-1 7h3.5c.49 0 .56.33.47.51l-.07.15C12.96 17.55 11 21 11 21z',
  },
];
---

<BaseLayout
  title="Nesbitt's Plumbing | Asheville & Hendersonville, NC Plumber"
  description={`Nesbitt's Plumbing (NPSCorp) has served Asheville & Hendersonville, NC since ${site.founded}. ${site.yearsInBusiness} years of licensed, insured plumbing repairs, water heaters, water and sewer lines, and new construction plumbing. Call ${site.phone}.`}
>
  <Hero
    size="lg"
    showEstBadge
    image="/images/hero-bathroom.jpg"
    title="Your Trusted Asheville & Hendersonville Plumber"
    subtitle={`Keeping water in-line with reliable plumbing solutions. With ${site.yearsInBusiness} years of experience, our licensed plumbers and contractors have seen it all. Clogged drain or a basement full of water, you'll get a prompt fix either way.`}
  />

  <!-- Highlights -->
  <section class="bg-charcoal-50">
    <div class="mx-auto grid max-w-7xl gap-6 px-4 py-14 sm:px-6 md:grid-cols-3">
      {
        highlights.map((h, i) => (
          <div
            class:list={[
              'rounded-2xl border border-charcoal-100 bg-white p-7 shadow-sm transition-shadow hover:shadow-float',
              i === 1 && 'md:-translate-y-4',
            ]}
            data-reveal
            style={`--reveal-delay: ${i * 90}ms`}
          >
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-drop-100 text-drop-600">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={h.iconPath} />
              </svg>
            </span>
            <h2 class="mt-4 text-xl font-bold text-navy-900">{h.title}</h2>
            <p class="mt-3 leading-relaxed text-charcoal-600">{h.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Mission statement -->
  <section class="mx-auto max-w-7xl px-4 pt-16 sm:px-6">
    <div class="grid items-center gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14">
      <div class="overflow-hidden rounded-2xl shadow-float" data-reveal>
        <img
          src="/images/gallery/owner-on-site.jpg"
          alt="A member of the Nesbitt's Plumbing team on a job site near Asheville, NC"
          width="1600"
          height="1067"
          loading="lazy"
          class="h-full w-full object-cover"
        />
      </div>
      <div data-reveal style="--reveal-delay: 90ms">
        <p class="text-sm font-bold uppercase tracking-widest text-drop-600">Our Mission</p>
        <blockquote class="mt-3 border-l-4 border-drop-400 pl-5 text-2xl font-bold leading-snug text-navy-900 sm:text-3xl">
          {site.mission}
        </blockquote>
        <p class="mt-6 leading-relaxed text-charcoal-600">
          Family owned and operated since {site.founded}, we hold every job to the same three
          values: <span class="font-semibold text-navy-900">{site.values.join(', ')}</span>.
        </p>
      </div>
    </div>
  </section>

  <!-- Featured services -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
    <div class="max-w-2xl" data-reveal>
      <p class="text-sm font-bold uppercase tracking-widest text-drop-600">What We Do</p>
      <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-charcoal-900 sm:text-4xl">
        One-Stop Shop for All Your Home's Needs
      </h2>
    </div>
    <div class="mt-10 grid gap-8 md:grid-cols-3">
      {
        featuredServices.map((s, i) => (
          <a
            href={s.href}
            class:list={[
              'group overflow-hidden rounded-2xl border border-charcoal-100 bg-white shadow-sm transition-shadow hover:shadow-float',
              i === 1 && 'md:mt-10',
            ]}
            data-reveal
            style={`--reveal-delay: ${i * 90}ms`}
          >
            <div class="h-52 overflow-hidden bg-navy-950">
              <img
                src={s.image}
                alt={`${s.title} in Asheville, NC`}
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-navy-900 group-hover:text-drop-600">{s.title}</h3>
              <p class="mt-2 leading-relaxed text-charcoal-600">{s.text}</p>
              <p class="mt-4 font-semibold text-drop-600">Learn more &rarr;</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- About / SEO block -->
  <section class="relative bg-navy-950 text-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr]">
        <div data-reveal>
          <p class="text-sm font-bold uppercase tracking-widest text-drop-400">
            {site.legalName} &bull; {site.est}
          </p>
          <h2 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">
            Nesbitt's Plumbing | Asheville &amp; Hendersonville, NC
          </h2>
          <p class="mt-3 text-lg font-semibold text-drop-300">
            Plumbing Repairs, Hot Water Heaters, Water &amp; Sewer Lines, New Construction
          </p>
          <div class="mt-6 space-y-4 leading-relaxed text-charcoal-200">
            <p>
              Nesbitt's Plumbing has handled plumbing installation and repair for Asheville, NC,
              Hendersonville, NC &amp; the surrounding areas since {site.founded}. If you need a
              plumber for your residential or commercial property within an hour of Asheville or
              Hendersonville, NC, you're in the right place. We're fully licensed and insured, with
              {site.yearsInBusiness} years of experience behind every job and prompt, reliable
              service for every customer.
            </p>
            <p>
              From a dripping faucet to a brand-new sewer line, Nesbitt's Plumbing covers a wide
              range of work.
              Because our licensed plumbers and contractors do it all in-house, you only have to make
              one call. Contact us today for a free estimate: <a href={site.phoneHref} class="font-semibold text-drop-300 underline-offset-2 hover:underline">{site.phone}</a>.
            </p>
          </div>
          <!-- Core values -->
          <div class="mt-8 flex flex-wrap gap-3">
            {
              site.values.map((v) => (
                <span class="inline-flex items-center rounded-full border border-drop-400/40 bg-navy-900 px-4 py-2 text-sm font-bold text-drop-300">
                  {v}
                </span>
              ))
            }
          </div>
        </div>

        <!-- Service list cards: lifted so they break across the section edge -->
        <div class="grid gap-6 sm:grid-cols-2 lg:-mt-32 lg:grid-cols-1">
          <div
            class="rounded-2xl border border-white/10 bg-navy-900 p-7 shadow-float"
            data-reveal
          >
            <h3 class="text-lg font-bold text-white">Typical Plumbing Services</h3>
            <ul class="mt-4 space-y-2.5 text-sm leading-relaxed text-charcoal-200">
              {
                plumbingList.map((item) => (
                  <li class="flex items-start gap-2.5">
                    <CheckIcon class="mt-0.5 h-4 w-4 shrink-0 text-drop-400" />
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div
            class="rounded-2xl border border-white/10 bg-navy-900 p-7 shadow-float"
            data-reveal
            style="--reveal-delay: 90ms"
          >
            <h3 class="text-lg font-bold text-white">Specialty Services</h3>
            <ul class="mt-4 space-y-2.5 text-sm leading-relaxed text-charcoal-200">
              {
                specialtyList.map((item) => (
                  <li class="flex items-start gap-2.5">
                    <CheckIcon class="mt-0.5 h-4 w-4 shrink-0 text-drop-400" />
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
            <a
              href="/contact-us"
              class="mt-6 inline-block rounded-lg bg-drop-500 px-5 py-2.5 text-sm font-bold text-navy-950 shadow-glow transition-colors hover:bg-drop-400"
            >
              Get a Free Estimate
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonial teaser -->
  <section class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6" data-reveal>
    <p class="font-serif text-7xl leading-none text-drop-300" aria-hidden="true">&ldquo;</p>
    <blockquote class="text-xl font-medium leading-relaxed text-charcoal-800 sm:text-2xl">
      "Very professional, did what they said they were going to do in a timely manner and at a
      fair price."
    </blockquote>
    <p class="mt-4 font-bold text-navy-900">C. Owen, Asheville, NC</p>
    <a href="/testimonials" class="mt-6 inline-block font-semibold text-drop-600 hover:underline">
      Read more reviews &rarr;
    </a>
  </section>

  <CtaBand
    heading="Ready for Reliable Plumbing in Asheville & Hendersonville, NC?"
    text={`Call ${site.phone} now for a free estimate.`}
  />
</BaseLayout>
